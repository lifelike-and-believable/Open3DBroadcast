# Build Artifacts
Artifacts/

# Unreal Generated Folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
# Content/ is tracked (sandbox maps and assets); only UE's per-user folders
# under it are ignored.
Content/Developers/
Content/Collections/

# Plugin symlink (created by Link script)
Plugins/*
!Plugins/Open3DBroadcast/
Plugins/Open3DBroadcast/**
!Plugins/Open3DBroadcast/Open3DBroadcast.uplugin
!Plugins/Open3DBroadcast/README.md
!Plugins/Open3DBroadcast/USER_GUIDE.md
!Plugins/Open3DBroadcast/Transport_Module_Comparison.md
!Plugins/Open3DBroadcast/LICENSE
!Plugins/Open3DBroadcast/THIRD_PARTY_LICENSES.md
!Plugins/Open3DBroadcast/Resources/
!Plugins/Open3DBroadcast/Resources/**
!Plugins/Open3DBroadcast/Source/
!Plugins/Open3DBroadcast/Source/**
!Plugins/Open3DBroadcast/ThirdParty/
!Plugins/Open3DBroadcast/ThirdParty/**

# Fix #203/#204: o3ds core (compiled lib + vendored headers/schema) is built
# from source by Build/Scripts/Sync-O3DSCore.ps1 in CI, not committed.
Plugins/Open3DBroadcast/ThirdParty/open3dstream/include/o3ds/
Plugins/Open3DBroadcast/ThirdParty/open3dstream/include/o3ds.fbs
Plugins/Open3DBroadcast/ThirdParty/open3dstream/include/o3ds_generated.h
Plugins/Open3DBroadcast/ThirdParty/open3dstream/include/core/
Plugins/Open3DBroadcast/ThirdParty/open3dstream/include/receiver/
Plugins/Open3DBroadcast/ThirdParty/open3dstream/lib/

# FAB-4 (WP-F3): debug symbols never live in the plugin tree. They are published
# as release assets (see Build/README.md, "Debug symbols"); fab-package.py fails
# if one is tracked anyway.
Plugins/Open3DBroadcast/**/*.pdb

Plugins/Open3DStream/

# Visual Studio
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates

# Rider
.idea/
*.sln.iml
